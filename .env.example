# Copy to .env for local development. Railway sets PORT itself.
PORT=3000

# Signs session tokens. Set a long random value in Railway → Variables.
# Changing it signs every user out.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the JSON data file is written. Point this at a Railway volume mount
# (for example /data) so records survive redeploys.
DATA_DIR=./data

# Password given to the seeded demo accounts on first boot.
DEMO_PASSWORD=demo1234
